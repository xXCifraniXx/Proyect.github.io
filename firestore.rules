rules_version = '2';

// Reglas de Firestore del sitio (plan gratuito Spark).
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
// Todo usa el mismo id de pareja "nosotros-7f3k9q2m" (cieloId de
// src/config/firebase.ts):
//   - cualquiera con el link puede leer;
//   - solo las cuentas de "miembros" (sesión de Google) pueden escribir, y
//     solo con la forma correcta.
// Todo lo demás queda cerrado. Para sumar a alguien, agrega su UID aquí y en
// "miembros" de src/config/firebase.ts (un test revisa que coincidan).
service cloud.firestore {
  match /databases/{database}/documents {
    function esMiembro() {
      return request.auth != null
        && request.auth.uid in [
          "Wi4gXbDEYTgsft4wiuhOvDLWhjo1", // Jorge
          "YDRuDgow9kck52TJY4P6ie8sbpe2" // Anthuanete
        ];
    }

    // Constelación: una estrella por documento.
    match /cielos/{cielo}/estrellas/{estrella} {
      allow read: if cielo == "nosotros-7f3k9q2m";
      allow delete: if cielo == "nosotros-7f3k9q2m" && esMiembro();
      allow create, update: if cielo == "nosotros-7f3k9q2m"
        && esMiembro()
        && estrella.size() <= 40
        && request.resource.data.keys().hasOnly(["x", "y", "label", "born"])
        && request.resource.data.x is number
        && request.resource.data.x >= 0 && request.resource.data.x <= 1
        && request.resource.data.y is number
        && request.resource.data.y >= 0 && request.resource.data.y <= 1
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.born is int;
    }

    // Ajuste compartido de las bajadas de mina (un solo documento).
    match /parejas/{pareja}/ajustes/{ajuste} {
      allow read: if pareja == "nosotros-7f3k9q2m" && ajuste == "bajadas";
      allow delete: if pareja == "nosotros-7f3k9q2m" && ajuste == "bajadas" && esMiembro();
      allow create, update: if pareja == "nosotros-7f3k9q2m" && ajuste == "bajadas"
        && esMiembro()
        && request.resource.data.keys().hasOnly(["proximaBajada", "diasMina", "diasDescanso", "horaRegreso", "actualizado"])
        && request.resource.data.proximaBajada is string
        && request.resource.data.proximaBajada.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.diasMina is int
        && request.resource.data.diasMina >= 1 && request.resource.data.diasMina <= 60
        && request.resource.data.diasDescanso is int
        && request.resource.data.diasDescanso >= 1 && request.resource.data.diasDescanso <= 60
        && request.resource.data.horaRegreso is string
        && request.resource.data.horaRegreso.matches("^[0-9]{2}:[0-9]{2}$")
        && request.resource.data.actualizado is int;
    }
  }
}
