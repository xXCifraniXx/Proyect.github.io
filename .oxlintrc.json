{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    // Avisa si un efecto o un useCallback usa algo que no está en sus dependencias.
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Propone <output> en vez de role="status" y <fieldset> en vez de role="group".
    // Esos roles son correctos, y la etiqueta que propone cambiaría cómo se ve o se anuncia.
    "jsx-a11y/prefer-tag-over-role": "off"
  }
}
